set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
if(NOT DEFINED ENV{MINGW_ROOT})
 message(FATAL_ERROR "Set MINGW_ROOT to the extracted MinGW prefix (directory containing usr)")
endif()
set(CMAKE_C_COMPILER "$ENV{MINGW_ROOT}/usr/bin/x86_64-w64-mingw32-gcc-posix")
set(CMAKE_CXX_COMPILER "$ENV{MINGW_ROOT}/usr/bin/x86_64-w64-mingw32-g++-posix")
set(CMAKE_RC_COMPILER "$ENV{MINGW_ROOT}/usr/bin/x86_64-w64-mingw32-windres")
set(CMAKE_FIND_ROOT_PATH "$ENV{MINGW_ROOT}/usr/x86_64-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_CXX_FLAGS_INIT "-static-libgcc -static-libstdc++ -static")
set(SMTG_CREATE_MODULE_INFO OFF CACHE BOOL "Cannot run Windows tools during cross-compilation")
# Cross-build a flat Windows module; packaging creates the standard bundle.
# SDK folder-icon commands require Windows attrib and are cosmetic only.
set(SMTG_CREATE_BUNDLE_FOR_WINDOWS OFF CACHE BOOL "Bundle is assembled by package step" FORCE)
